// Ashivam Technologies — database schema
//
// Source of truth for every public form submission. The API persists
// here BEFORE attempting any email notification (see server/src/routes),
// so a failed or unconfigured mail provider never loses a submission.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  SPAM
}

enum ApplicationStatus {
  RECEIVED
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
}

model ContactInquiry {
  id              String     @id @default(cuid())
  fullName        String
  workEmail       String
  phone           String?
  company         String?
  service         String
  budget          String?
  projectDetails  String     @db.Text
  status          LeadStatus @default(NEW)

  // Prevents duplicate inserts when a client retries a submission
  // (e.g. network timeout + user resubmits). The client generates a
  // stable key per form-fill (see src/lib/idempotency.ts) and the DB
  // enforces uniqueness — the route treats a repeat key as a no-op
  // success rather than a second row.
  idempotencyKey  String?    @unique

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_inquiries")
}

model CareerApplication {
  id              String            @id @default(cuid())
  fullName        String
  email           String
  phone           String
  role            String
  linkedin        String?
  github          String?
  message         String?           @db.Text
  status          ApplicationStatus @default(RECEIVED)
  idempotencyKey  String?           @unique

  // Resume storage: local disk in development (server/uploads/resumes),
  // meant to be swapped for object storage (S3, Cloudinary, etc.) before
  // a multi-instance or ephemeral-filesystem production deployment —
  // see server/src/lib/upload.ts. resumeUrl is the path the admin API
  // serves the file from; resumeFileName preserves the applicant's
  // original filename for download.
  resumeUrl       String?
  resumeFileName  String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("career_applications")
}
